## Database Configuration
## Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL="postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/nova_crm"

## Auth Configuration (better-auth variables)
## Generate a strong secret with: openssl rand -hex 32
BETTER_AUTH_SECRET="REPLACE_WITH_A_STRONG_RANDOM_SECRET"
BETTER_AUTH_URL="http://localhost:5173"

## App Configuration
PORT=3000
NODE_ENV="development"

# App version (must match version.json at release time)
PUBLIC_APP_VERSION=1.0.0

# Watchtower HTTP API (Docker update service)
WATCHTOWER_API_URL=http://watchtower:8080
WATCHTOWER_API_TOKEN=change-me-to-a-strong-secret

# Public gist - update content on each release: gh gist edit bb9bc3f021cffa5b80603b2a0c21a9e0
VERSION_CHECK_URL=https://gist.githubusercontent.com/youngrichu/bb9bc3f021cffa5b80603b2a0c21a9e0/raw/version.json
